# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088
TEMPORAL_VERSION=latest
TEMPORAL_UI_VERSION=latest

# PostgreSQL
POSTGRES_USER=memoryhive
POSTGRES_PASSWORD=memoryhive123
POSTGRES_DB=memoryhive

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=memoryhive-uploads

# Backend security
# Generate unique production values; never deploy these development examples.
JWT_SECRET_KEY=dev-secret-key-change-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY=dev-encryption-key-32-bytes-long!
ADMIN_BOOTSTRAP_EMAILS=[]
BACKUP_ROOT=backups
BACKUP_RETENTION_DAYS=14
ADMIN_BACKUP_COMMAND=
ADMIN_BACKUP_WORKING_DIR=
ADMIN_BACKUP_TIMEOUT_SECONDS=900
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=memoryhive-analysis
TEMPORAL_SCHEDULER_POLL_SECONDS=10
TEMPORAL_SCHEDULER_BATCH_SIZE=25

# JSON array consumed by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000"]

# Frontend API base. The development server proxies same-origin API routes.
VITE_API_URL=/api/v1
VITE_SUPPORT_EMAIL=support@memoryhive.example.com

# Mobile runtime configuration.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Mobile store review handoff. Do not commit real review-account passwords.
STORE_REVIEW_ACCOUNT_EMAIL=reviewer@memoryhive.example.com

# Store privacy/data-safety disclosure helpers. Keep these aligned with production services.
STORE_EXTERNAL_AI_PROCESSING=none
STORE_PRODUCTION_TELEMETRY=none

# Optional enrichment; core link extraction and screenshot OCR work without these.
N8N_WEBHOOK_URL=
N8N_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
