# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# PostgreSQL
POSTGRES_USER=memoryhive
POSTGRES_PASSWORD=memoryhive123
POSTGRES_DB=memoryhive

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=memoryhive-uploads

# Backend security
# Generate unique production values; never deploy these development examples.
JWT_SECRET_KEY=dev-secret-key-change-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY=dev-encryption-key-32-bytes-long!

# JSON array consumed by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000"]

# Browser-reachable backend origin. API routes are served under /api/v1.
VITE_API_URL=http://localhost:8000/api/v1

# Optional enrichment; core link extraction and screenshot OCR work without these.
N8N_WEBHOOK_URL=
N8N_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
