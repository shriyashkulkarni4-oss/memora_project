OPENAI_COMPATIBLE_CAPABILITIES=["enrichment","model_listing","token_usage","health"]
OPENAI_COMPATIBLE_CHAT_MODELS=[]
OPENAI_COMPATIBLE_EMBEDDING_MODELS=[]
OPENAI_COMPATIBLE_ALLOWED_HOSTS=[]
OPENAI_COMPATIBLE_ALLOW_PRIVATE_NETWORK=false
OPENAI_COMPATIBLE_PRIVATE_HOSTS=[]
