AI_EXTERNAL_CONTENT_ALLOWED=false
AI_ALLOWED_EXTERNAL_PROVIDERS=[]
AI_DAILY_REQUEST_BUDGET=0
AI_MONTHLY_REQUEST_BUDGET=0
AI_DAILY_TOKEN_BUDGET=0
AI_MONTHLY_TOKEN_BUDGET=0
AI_DAILY_COST_BUDGET_USD=0
AI_MONTHLY_COST_BUDGET_USD=0
AI_PER_USER_DAILY_REQUEST_QUOTA=0
AI_PER_USER_MONTHLY_REQUEST_QUOTA=0
AI_PER_USER_DAILY_TOKEN_QUOTA=0
AI_PER_USER_MONTHLY_TOKEN_QUOTA=0
AI_SUGGESTION_AUTO_APPLY_THRESHOLD=0
OLLAMA_TIMEOUT_SECONDS=30
N8N_TIMEOUT_SECONDS=15
N8N_SIGNING_SECRET=
N8N_DEPLOYMENT_TYPE=self_hosted
OLLAMA_EMBEDDING_MODEL=
OLLAMA_KEEP_ALIVE=5m
OLLAMA_DEPLOYMENT_TYPE=self_hosted
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
