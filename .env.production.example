# Copy to an access-controlled deployment environment. Never commit real values.
APP_DOMAIN=memoryhive.example.com
ACME_EMAIL=operations@example.com
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_IMAGE=ghcr.io/coding-monkey-labs-client-projects/cml-memoryhive-backend:v0.0.0-0000000
FRONTEND_IMAGE=ghcr.io/coding-monkey-labs-client-projects/cml-memoryhive-frontend:v0.0.0-0000000
POSTGRES_USER=memoryhive
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=memoryhive
MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_BUCKET=memoryhive-uploads
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=["https://memoryhive.example.com"]
ALLOWED_HOSTS=["memoryhive.example.com","cml-memoryhive-backend"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
ADMIN_BOOTSTRAP_EMAILS=["admin@memoryhive.example.com"]
BACKUP_ROOT=/srv/memoryhive-backups
BACKUP_RETENTION_DAYS=14
ADMIN_BACKUP_COMMAND=
ADMIN_BACKUP_WORKING_DIR=
ADMIN_BACKUP_TIMEOUT_SECONDS=900
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=temporal.example.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=memoryhive-analysis
TEMPORAL_SCHEDULER_POLL_SECONDS=10
TEMPORAL_SCHEDULER_BATCH_SIZE=25
VITE_SUPPORT_EMAIL=support@memoryhive.example.com
EXPO_PUBLIC_API_URL=https://memoryhive.example.com/api/v1
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://memoryhive.example.com/privacy
EXPO_PUBLIC_SUPPORT_URL=https://memoryhive.example.com/support

# Create a dedicated temporary reviewer account before store submission.
# Do not commit its password; enter the password directly in App Store Connect and Play Console.
STORE_REVIEW_ACCOUNT_EMAIL=reviewer@memoryhive.example.com

# Store privacy/data-safety disclosure helpers. Allowed external AI values:
# none, self_hosted, or third_party. Allowed telemetry values:
# none, analytics, crash_reporting, analytics_and_crash_reporting, or other.
STORE_EXTERNAL_AI_PROCESSING=none
STORE_PRODUCTION_TELEMETRY=none

# Optional enrichment
N8N_WEBHOOK_URL=
N8N_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
