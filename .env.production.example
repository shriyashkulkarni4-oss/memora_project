OPENAI_COMPATIBLE_TEMPERATURE=0.1
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=45
OPENAI_COMPATIBLE_DEPLOYMENT_TYPE=third_party
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=temporal.example.internal:7233
TEMPORAL_UI_URL=https://temporal.example.internal
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=memoryhive-analysis
TEMPORAL_SCHEDULER_POLL_SECONDS=10
TEMPORAL_SCHEDULER_BATCH_SIZE=25
TEMPORAL_WORKER_BUILD_ID=memoryhive-analysis-v1
