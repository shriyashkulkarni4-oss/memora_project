# Copy to an access-controlled deployment environment. Never commit real values.
APP_DOMAIN=www.memoryhive.in
ACME_EMAIL=operations@example.com
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_IMAGE=docker.io/maheshk172/cml-memoryhive-backend:v0.0.0-0000000
FRONTEND_IMAGE=docker.io/maheshk172/cml-memoryhive-frontend:v0.0.0-0000000
POSTGRES_USER=memoryhive
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=memoryhive
MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_BUCKET=memoryhive-uploads
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=["https://www.memoryhive.in"]
ALLOWED_HOSTS=["www.memoryhive.in","cml-memoryhive-backend"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
ADMIN_BOOTSTRAP_EMAILS=["admin@memoryhive.example.com"]
BACKUP_ROOT=/srv/memoryhive-backups
BACKUP_RETENTION_DAYS=14
ADMIN_BACKUP_COMMAND=
ADMIN_BACKUP_WORKING_DIR=
ADMIN_BACKUP_TIMEOUT_SECONDS=900
AI_PROVIDER_CONCURRENCY=4
AI_PROVIDER_MAX_PAYLOAD_BYTES=512000
AI_PROVIDER_MAX_ATTEMPTS=3
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_SECONDS=60
AI_SUMMARIZATION_ROUTE=
AI_SUMMARIZATION_FALLBACK_ROUTES=[]
AI_ENRICHMENT_ROUTE=
AI_ENRICHMENT_FALLBACK_ROUTES=[]
AI_EMBEDDINGS_ROUTE=
