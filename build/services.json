{
  "default_registry": "ghcr.io",
  "default_namespace": "memoryhive/memoryhive",
  "default_platforms": ["linux/amd64", "linux/arm64"],
  "images": [
    {
      "name": "backend",
      "image_suffix": "backend",
      "context": "backend",
      "dockerfile": "Dockerfile",
      "target": "production",
      "build_args": {}
    },
    {
      "name": "frontend",
      "image_suffix": "frontend",
      "context": "frontend",
      "dockerfile": "Dockerfile",
      "target": "production",
      "build_args": {
        "VITE_API_URL": "/api/v1"
      }
    }
  ],
  "runtime": {
    "backend": "backend",
    "worker": "backend",
    "temporal-worker": "backend",
    "temporal-scheduler": "backend",
    "frontend": "frontend"
  }
}
