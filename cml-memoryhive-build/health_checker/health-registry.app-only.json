{
  "profile": "app-only",
  "services": {
    "cml-memoryhive-backend": {
      "kind": "service",
      "host": "127.0.0.1",
      "port": 8000,
      "health": {
        "type": "http",
        "path": "/health/ready"
      },
      "container": "cml-memoryhive-backend",
      "deployment": "cml-memoryhive-backend"
    },
    "cml-memoryhive-worker": {
      "kind": "process",
      "host": "127.0.0.1",
      "port": 0,
      "health": {
        "type": "process",
        "marker": "app.worker"
      },
      "container": "cml-memoryhive-worker",
      "deployment": "cml-memoryhive-worker"
    },
    "cml-memoryhive-frontend": {
      "kind": "frontend",
      "host": "127.0.0.1",
      "port": 3000,
      "health": {
        "type": "http",
        "path": "/"
      },
      "container": "cml-memoryhive-frontend",
      "deployment": "cml-memoryhive-frontend"
    }
  }
}
