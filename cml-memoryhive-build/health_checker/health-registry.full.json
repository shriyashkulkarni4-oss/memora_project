{
  "profile": "full",
  "services": {
    "db": {
      "key": "db",
      "kind": "infra",
      "host": "127.0.0.1",
      "port": 5432,
      "host_port_env": "POSTGRES_PORT",
      "health": {
        "type": "tcp"
      },
      "container": "cml-memoryhive-db",
      "kubernetes": {
        "kind": "statefulset",
        "name": "db"
      }
    },
    "redis": {
      "key": "redis",
      "kind": "infra",
      "host": "127.0.0.1",
      "port": 6379,
      "host_port_env": "REDIS_PORT",
      "health": {
        "type": "tcp"
      },
      "container": "cml-memoryhive-redis",
      "kubernetes": {
        "kind": "deployment",
        "name": "redis"
      }
    },
    "minio": {
      "key": "minio",
      "kind": "infra",
      "host": "127.0.0.1",
      "port": 9000,
      "host_port_env": "MINIO_API_PORT",
      "health": {
        "type": "http",
        "path": "/minio/health/ready"
      },
      "container": "cml-memoryhive-minio",
      "kubernetes": {
        "kind": "statefulset",
        "name": "minio"
      }
    },
    "cml-memoryhive-backend": {
      "key": "cml-memoryhive-backend",
      "kind": "service",
      "host": "127.0.0.1",
      "port": 8000,
      "host_port_env": "BACKEND_PORT",
      "health": {
        "type": "http",
        "path": "/health/ready"
      },
      "container": "cml-memoryhive-backend",
      "kubernetes": {
        "kind": "deployment",
        "name": "cml-memoryhive-backend"
      }
    },
    "cml-memoryhive-worker": {
      "key": "cml-memoryhive-worker",
      "kind": "process",
      "host": "127.0.0.1",
      "port": 0,
      "host_port_env": null,
      "health": {
        "type": "process",
        "marker": "app.worker"
      },
      "container": "cml-memoryhive-worker",
      "kubernetes": {
        "kind": "deployment",
        "name": "cml-memoryhive-worker"
      }
    },
    "cml-memoryhive-frontend": {
      "key": "cml-memoryhive-frontend",
      "kind": "frontend",
      "host": "127.0.0.1",
      "port": 3000,
      "host_port_env": "FRONTEND_PORT",
      "health": {
        "type": "http",
        "path": "/"
      },
      "container": "cml-memoryhive-frontend",
      "kubernetes": {
        "kind": "deployment",
        "name": "cml-memoryhive-frontend"
      }
    }
  }
}
