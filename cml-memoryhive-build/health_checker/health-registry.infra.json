{
  "profile": "infra",
  "services": {
    "db": {
      "kind": "infra",
      "host": "127.0.0.1",
      "port": 5432,
      "health": {
        "type": "tcp"
      },
      "container": "cml-memoryhive-db",
      "deployment": null
    },
    "redis": {
      "kind": "infra",
      "host": "127.0.0.1",
      "port": 6379,
      "health": {
        "type": "tcp"
      },
      "container": "cml-memoryhive-redis",
      "deployment": null
    },
    "minio": {
      "kind": "infra",
      "host": "127.0.0.1",
      "port": 9000,
      "health": {
        "type": "http",
        "path": "/minio/health/ready"
      },
      "container": "cml-memoryhive-minio",
      "deployment": null
    }
  }
