{
  "schema_version": 1,
  "app": "cml-memoryhive",
  "registry": "docker.io",
  "registry_namespace": "maheshk172",
  "platforms": ["linux/amd64", "linux/arm64"],
  "images": [
    {
      "key": "cml-memoryhive-backend",
      "context": "cml-memoryhive-backend",
      "dockerfile": "Dockerfile",
      "target": "production",
      "runtime_target": "development",
      "build_args": {}
    },
    {
      "key": "cml-memoryhive-frontend",
      "context": "cml-memoryhive-frontend",
      "dockerfile": "Dockerfile",
      "target": "production",
      "runtime_target": "development",
      "build_args": {
        "VITE_API_URL": "/api/v1",
        "VITE_SUPPORT_EMAIL": "$VITE_SUPPORT_EMAIL"
      }
    }
  ],
  "profiles": {
    "infra": ["db", "redis", "minio"],
    "app-only": ["cml-memoryhive-backend", "cml-memoryhive-worker", "cml-memoryhive-frontend"],
    "full": ["db", "redis", "minio", "cml-memoryhive-backend", "cml-memoryhive-worker", "cml-memoryhive-frontend"],
    "temporal": ["db", "redis", "minio", "temporal-db", "temporal", "temporal-ui", "cml-memoryhive-backend", "cml-memoryhive-worker", "cml-memoryhive-temporal-worker", "cml-memoryhive-temporal-scheduler", "cml-memoryhive-frontend"],
    "observability": ["db", "redis", "minio", "temporal-db", "temporal", "temporal-ui", "cml-memoryhive-backend", "cml-memoryhive-worker", "cml-memoryhive-temporal-worker", "cml-memoryhive-temporal-scheduler", "cml-memoryhive-frontend", "prometheus", "alertmanager", "grafana"]
  },
  "services": [
    {
      "key": "db",
      "kind": "infra",
      "port": 5432,
      "host_port_env": "POSTGRES_PORT",
      "host_port": 5432,
      "image": "postgres:15.19-alpine",
      "kubernetes": {"kind": "statefulset", "name": "db"},
      "health": {"type": "tcp"},
      "depends_on": []
    },
    {
      "key": "redis",
      "kind": "infra",
      "port": 6379,
      "host_port_env": "REDIS_PORT",
      "host_port": 6379,
      "image": "redis:7.4.11-alpine",
      "kubernetes": {"kind": "deployment", "name": "redis"},
      "health": {"type": "tcp"},
      "depends_on": []
    },
    {
      "key": "minio",
      "kind": "infra",
      "port": 9000,
      "host_port_env": "MINIO_API_PORT",
      "host_port": 9000,
      "additional_ports": [
        {
          "name": "console",
          "port": 9001,
          "host_port_env": "MINIO_CONSOLE_PORT",
          "host_port": 9001
        }
      ],
      "image": "quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z",
      "kubernetes": {"kind": "statefulset", "name": "minio"},
      "health": {"type": "http", "path": "/minio/health/ready"},
      "depends_on": []
    },
    {
      "key": "temporal-db",
      "kind": "infra",
      "port": 5432,
      "image": "postgres:15.19-alpine",
      "health": {"type": "process"},
      "depends_on": []
    },
    {
      "key": "temporal",
      "kind": "infra",
      "port": 7233,
      "host_port_env": "TEMPORAL_PORT",
      "host_port": 7233,
      "image": "temporalio/auto-setup:${TEMPORAL_VERSION:-1.29.7}",
      "health": {"type": "tcp"},
      "depends_on": ["temporal-db"]
    },
    {
      "key": "temporal-ui",
      "kind": "infra",
      "port": 8080,
      "host_port_env": "TEMPORAL_UI_PORT",
      "host_port": 8088,
      "image": "temporalio/ui:${TEMPORAL_UI_VERSION:-2.54.1}",
      "health": {"type": "http", "path": "/"},
      "depends_on": ["temporal"]
    },
    {
      "key": "prometheus",
      "kind": "infra",
      "port": 9090,
      "host_port_env": "PROMETHEUS_PORT",
      "host_port": 9090,
      "image": "prom/prometheus:v3.14.0",
      "health": {"type": "http", "path": "/-/ready"},
      "depends_on": ["cml-memoryhive-backend", "cml-memoryhive-worker", "cml-memoryhive-temporal-worker", "cml-memoryhive-temporal-scheduler", "temporal"]
    },
    {
      "key": "alertmanager",
      "kind": "infra",
      "port": 9093,
      "host_port_env": "ALERTMANAGER_PORT",
      "host_port": 9093,
      "image": "prom/alertmanager:v0.30.1",
      "health": {"type": "http", "path": "/-/ready"},
      "depends_on": []
    },
    {
      "key": "grafana",
      "kind": "infra",
      "port": 3000,
      "host_port_env": "GRAFANA_PORT",
      "host_port": 3001,
      "image": "grafana/grafana:12.3.5",
      "health": {"type": "http", "path": "/api/health"},
      "depends_on": ["prometheus"]
    },
    {
      "key": "cml-memoryhive-backend",
      "kind": "service",
      "port": 8000,
      "host_port_env": "BACKEND_PORT",
      "host_port": 8000,
      "image_key": "cml-memoryhive-backend",
      "kubernetes": {"kind": "deployment", "name": "cml-memoryhive-backend"},
      "source": "cml-memoryhive-backend",
      "command": ["uv", "run", "--frozen", "--no-sync", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "health": {"type": "http", "path": "/health/ready"},
      "depends_on": ["db", "redis", "minio"]
    },
    {
      "key": "cml-memoryhive-worker",
      "kind": "process",
      "port": 0,
      "image_key": "cml-memoryhive-backend",
      "kubernetes": {"kind": "deployment", "name": "cml-memoryhive-worker"},
      "source": "cml-memoryhive-backend",
      "command": ["uv", "run", "--frozen", "--no-sync", "python", "-m", "app.worker"],
      "health": {"type": "process", "marker": "app.worker"},
      "depends_on": ["db", "minio"]
    },
    {
      "key": "cml-memoryhive-temporal-worker",
      "kind": "process",
      "port": 0,
      "image_key": "cml-memoryhive-backend",
      "kubernetes": {"kind": "deployment", "name": "cml-memoryhive-temporal-worker"},
      "source": "cml-memoryhive-backend",
      "command": ["uv", "run", "--frozen", "--no-sync", "python", "-m", "app.temporal_pipeline.worker"],
      "health": {"type": "process", "marker": "app.temporal_pipeline.worker"},
      "depends_on": ["db", "minio", "temporal"]
    },
    {
      "key": "cml-memoryhive-temporal-scheduler",
      "kind": "process",
      "port": 0,
      "image_key": "cml-memoryhive-backend",
      "kubernetes": {"kind": "deployment", "name": "cml-memoryhive-temporal-scheduler"},
      "source": "cml-memoryhive-backend",
      "command": ["uv", "run", "--frozen", "--no-sync", "python", "-m", "app.temporal_pipeline.scheduler"],
      "health": {"type": "process", "marker": "app.temporal_pipeline.scheduler"},
      "depends_on": ["db", "temporal"]
    },
    {
      "key": "cml-memoryhive-frontend",
      "kind": "frontend",
      "port": 3000,
      "host_port_env": "FRONTEND_PORT",
      "host_port": 3000,
      "image_key": "cml-memoryhive-frontend",
      "kubernetes": {"kind": "deployment", "name": "cml-memoryhive-frontend"},
      "source": "cml-memoryhive-frontend",
      "command": ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"],
      "health": {"type": "http", "path": "/"},
      "depends_on": ["cml-memoryhive-backend"]
    }
  ]
}
