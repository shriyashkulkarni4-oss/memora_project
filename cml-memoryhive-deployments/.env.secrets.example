# Local-only examples. Staging and production reject these placeholder values.
POSTGRES_USER=memoryhive
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=memoryhive
MINIO_ROOT_USER=memoryhive-storage
MINIO_ROOT_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://HOST:6379/0
MINIO_ENDPOINT=HOST:9000
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key
JWT_SECRET_KEY=replace-with-32-plus-character-secret
ENCRYPTION_KEY=replace-with-32-plus-character-key
# Optional AI provider values are streamed directly to Kubernetes Secret objects.
# Enable only providers selected by an explicit AI_*_ROUTE policy.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
HUGGINGFACE_ENABLED=false
HUGGINGFACE_TOKEN=
HUGGINGFACE_CHAT_MODEL=
HUGGINGFACE_EMBEDDING_MODEL=
OPENAI_COMPATIBLE_ENABLED=false
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_ALLOWED_HOSTS=[]
N8N_WEBHOOK_URL=
N8N_API_KEY=
N8N_SIGNING_SECRET=
OLLAMA_BASE_URL=
AI_ENRICHMENT_ROUTE=
AI_EXTERNAL_CONTENT_ALLOWED=false
AI_ALLOWED_EXTERNAL_PROVIDERS=[]
