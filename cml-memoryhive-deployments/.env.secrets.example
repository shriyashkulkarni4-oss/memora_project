# Local-only examples. Staging and production reject these placeholder values.
POSTGRES_USER=memoryhive
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=memoryhive
MINIO_ROOT_USER=memoryhive-storage
MINIO_ROOT_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://HOST:6379/0
MINIO_ENDPOINT=HOST:9000
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key
JWT_SECRET_KEY=replace-with-32-plus-character-secret
ENCRYPTION_KEY=replace-with-32-plus-character-key
