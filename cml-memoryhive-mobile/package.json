{
  "name": "cml-memoryhive-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --clear",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:e2e:web": "playwright test --config playwright.web.config.ts",
    "eas:build:preflight": "node scripts/check-eas-ci-preflight.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "store:screenshots": "node scripts/capture-store-screenshots.mjs",
    "store:submission": "node scripts/generate-store-submission.mjs",
    "store:submission:check": "node scripts/generate-store-submission.mjs --check",
    "store:check": "node scripts/check-store-readiness.mjs",
    "store:check:ci": "node scripts/check-store-readiness.mjs --ci",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "8.0.1",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.2.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-x": "^5.19.0",
    "globals": "^17.12.0",
    "patch-package": "^8.0.0",
    "pngjs": "^7.0.0",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
