{
  "expo": {
    "name": "Memoryhive",
    "slug": "memoryhive",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "memoryhive",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codingmonkeylabs.memoryhive",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose screenshots to save in Memoryhive.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.codingmonkeylabs.memoryhive",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F8F6"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        { "photosPermission": "Choose screenshots to save in Memoryhive." }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": ["text/*", "image/*"]
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiUrl": "http://localhost:8000/api/v1",
      "eas": {}
    }
  }
}
