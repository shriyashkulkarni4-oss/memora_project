{
  "name": "memoryhive-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:e2e:web": "playwright test --config playwright.web.config.ts",
    "eas:build:preflight": "node scripts/check-eas-ci-preflight.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "store:screenshots": "node scripts/capture-store-screenshots.mjs",
    "store:submission": "node scripts/generate-store-submission.mjs",
    "store:submission:check": "node scripts/generate-store-submission.mjs --check",
    "store:check": "node scripts/check-store-readiness.mjs",
    "store:check:ci": "node scripts/check-store-readiness.mjs --ci",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.0.3",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "5.1.1",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.0",
    "pngjs": "^3.4.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
