{
  "uid": "memoryhive-ai",
  "title": "Memoryhive AI Providers and Cost",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "tags": ["memoryhive", "ai", "owned"],
  "links": [{"title": "Provider Runbook", "url": "https://www.memoryhive.in/runbooks/observability#provider-auth", "type": "link"}],
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Calls by Provider and Outcome", "datasource": {"type": "prometheus", "uid": "memoryhive-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (provider, model_alias, task, outcome) (rate(memoryhive_ai_calls_total[5m]))"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "type": "timeseries", "title": "Provider p95 Latency", "datasource": {"type": "prometheus", "uid": "memoryhive-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, provider, model_alias, task) (rate(memoryhive_ai_latency_seconds_bucket[5m])))"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "Tokens and Estimated Cost", "datasource": {"type": "prometheus", "uid": "memoryhive-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (provider, task) (rate(memoryhive_ai_tokens_total[1h]))"}, {"refId": "B", "expr": "sum by (provider, task) (rate(memoryhive_ai_estimated_cost_usd_total[1h]))"}], "gridPos": {"h": 8, "w": 16, "x": 0, "y": 8}},
    {"id": 4, "type": "stat", "title": "Open Circuits", "datasource": {"type": "prometheus", "uid": "memoryhive-prometheus"}, "targets": [{"refId": "A", "expr": "sum(memoryhive_ai_circuit_open)"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}},
    {"id": 5, "type": "stat", "title": "Cost per Analyzed Item", "datasource": {"type": "prometheus", "uid": "memoryhive-prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(memoryhive_ai_estimated_cost_usd_total[1h])) / clamp_min(sum(rate(memoryhive_analysis_outcomes_total{stage=\"persist\",outcome=\"completed\"}[1h])), 0.001)"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}}
  ]
}
